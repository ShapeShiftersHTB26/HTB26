# Prediction-market backend, when run outside Docker (cargo run). Copy to backend/.env.
# scripts/setup.sh writes this file for you; Docker sets these in the root docker-compose.yml instead.

# --- required ---
# prediction-market-db from the root compose (docker compose up -d prediction-market-db)
DATABASE_URL=postgres://pm:pm@localhost:5433/pm
# Header x-admin-key for admin endpoints
ADMIN_API_KEY=change-me
# mUSDC mint pubkey; or leave empty and point MUSDC_MINT_KEYPAIR at the mint keypair
MUSDC_MINT=

# --- chain ---
RPC_URL=http://127.0.0.1:8899
# RPC handed to browsers via /config (defaults to RPC_URL)
# PUBLIC_RPC_URL=http://127.0.0.1:8899
ADMIN_KEYPAIR=../keys/admin.json
MUSDC_MINT_KEYPAIR=../keys/musdc-mint.json
# PROGRAM_ID=5XrnC3eMafJx5ckPKk6Mw5nvX1TJAQ2VaU9xEXR4nLyE
# OPENBOOK_PROGRAM_ID=opnb2LAfJYbRMAHHvqjCwQxanZn7ReEHp1k81EohpZb

# --- server / bots ---
BIND_ADDR=0.0.0.0:8080
BOT_COUNT=5
BOT_INTERVAL_MS=3000
BOTS_AUTOSTART=true
BOT_KEYS_DIR=../keys/bots
# SOL (lamports) sent with each faucet claim; 0 disables
FAUCET_SOL_LAMPORTS=50000000
RUST_LOG=pm_backend=info,tower_http=info

# --- local convenience (Docker turns all three on) ---
# Generate missing admin / mint keypairs
# AUTO_CREATE_KEYS=true
# Airdrop admin, create the mUSDC mint, init program Config before serving
# BOOTSTRAP_ON_START=true
# Create 2 demo markets when the database is empty
# DEMO_MARKETS=true
