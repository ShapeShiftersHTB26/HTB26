# Prediction-market backend for the prod compose (docker-compose.prod.yml at the repo root).
# Copy to prediction-market/.env.prod (gitignored) and fill in.

# --- required ---
# Hosted Postgres. Keep ?sslmode=require if your provider uses TLS (most do).
# Use a direct or session-mode connection string: transaction poolers (e.g. Supabase port 6543) break prepared statements.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Solana devnet RPC. A free Helius/Triton devnet URL copes with the bots better than the public endpoint.
RPC_URL=https://api.devnet.solana.com
# Header x-admin-key for admin endpoints (resolve, bots)
ADMIN_API_KEY=change-me

# --- optional ---
# RPC that browsers get from /config (defaults to RPC_URL). Set it if RPC_URL contains a private API key.
# PUBLIC_RPC_URL=https://api.devnet.solana.com
# Bots and the faucet are paid by the admin wallet; devnet SOL is scarce, so go easy.
BOT_COUNT=3
BOT_INTERVAL_MS=5000
# SOL (lamports) sent with each faucet claim
FAUCET_SOL_LAMPORTS=20000000
# Create 2 demo markets when the database is empty (about 4 SOL of rent each)
# DEMO_MARKETS=true
# RUST_LOG=pm_backend=info,tower_http=warn
