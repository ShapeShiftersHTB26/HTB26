# Copy to .env (gitignored). docker compose reads it automatically: cp .env.example .env

# Required for agentic transforms (agent_map / agent_reduce) and the web chat in the api service.
ANTHROPIC_API_KEY=

# Optional: model used by agentic transforms (default claude-haiku-5-5).
BACKTRACE_MODEL=
# Optional: model for the app agent behind the web chat and research threads (default claude-haiku-5-5).
BACKTRACE_AGENT_MODEL=
# Research threads are served by the api (on). Set off to serve them with scripts/runner.py on the host instead.
BACKTRACE_THREAD_WORKER=on

# The prediction-market services need nothing here: their config is inline in docker-compose.yml
# (admin API key: dev-admin-key). For running the Rust backend outside Docker, see
# prediction-market/backend/.env.example.
# The api opens and settles data-settled markets with the backend's admin key (default dev-admin-key).
# Prod (docker-compose.prod.yml): required, set it to ADMIN_API_KEY from prediction-market/.env.prod.
PM_ADMIN_KEY=

# Postgres data plane (remote cluster), e.g. postgresql://user:password@host:5432/dbname?sslmode=require
PG_DSN=

# Default row store for new data: postgres | graph (Record nodes in Memgraph). Per source: ingest(..., storage=...)
BACKTRACE_STORE=postgres

# --- VPS deploy only (docs/DEPLOY.md). Leave unset locally.
# Public domain Caddy serves (and gets the HTTPS certificate for):
# DOMAIN=backtrace.example.com
# Makes a plain `docker compose` use the prod + VPS overrides:
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml:docker-compose.vps.yml

# Optional: the code visitors must enter before the site loads (required by docker-compose.prod.yml). Empty = no gate.
ACCESS_CODE=
