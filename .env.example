# Copy to .env (gitignored). docker compose reads it automatically: cp .env.example .env

# Required for agentic transforms (agent_map / agent_reduce) and the web chat in the api service.
ANTHROPIC_API_KEY=

# Optional: model used by agentic transforms (default claude-opus-5-5).
BACKTRACE_MODEL=claude-opus-5-5
# Optional: model for the app agent behind the web chat and research threads (default claude-sonnet-5-5).
BACKTRACE_AGENT_MODEL=
# Research threads are served by the api (on). Set off to serve them with scripts/runner.py on the host instead.
BACKTRACE_THREAD_WORKER=on

# The prediction-market services need nothing here: their config is inline in docker-compose.yml
# (admin API key: dev-admin-key). For running the Rust backend outside Docker, see
# prediction-market/backend/.env.example.

# Postgres data plane (remote cluster), e.g. postgresql://user:password@host:5432/dbname?sslmode=require
PG_DSN=

# Default row store for new data: postgres | graph (Record nodes in Memgraph). Per source: ingest(..., storage=...)
BACKTRACE_STORE=postgres
