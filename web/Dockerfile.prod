# Production frontend (docker-compose.vps.yml): build the static bundle, serve it with Caddy, which also proxies
# /api and /pm-api and gets the HTTPS certificate (deploy/Caddyfile). Local dev keeps the Vite server (Dockerfile).
FROM node:22-alpine AS build
WORKDIR /srv
COPY package.json ./
RUN npm install --no-audit --no-fund
COPY . .
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /srv/dist /srv
